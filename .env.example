PORT=4000
CAR_FEED_URL=https://partner.example.com/api/cars
CAR_FEED_API_KEY=replace-with-partner-key
SYNC_TOKEN=replace-with-long-random-token
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-unique-password
SESSION_SECRET=replace-with-at-least-32-random-characters
# На Vercel Blob использует системные BLOB_STORE_ID и VERCEL_OIDC_TOKEN.
# Для локальной работы можно дополнительно указать BLOB_READ_WRITE_TOKEN.
SYNC_INTERVAL_MINUTES=60
